# ════════════════════════════════════════════════════════════════════
#  ASTRA environment
#
#  Copy to .env.local. Every value below is OPTIONAL — the app boots
#  with zero configuration against the in-memory corpus.
# ════════════════════════════════════════════════════════════════════

# ── Session signing ────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. The development fallback is a known constant
# and is useless as a secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# ── Data source ────────────────────────────────────────────────────
# "memory" (default) — process-local seeded store, zero setup.
# "prisma"           — PostgreSQL. Requires DATABASE_URL below, plus:
#                        npm run db:generate && npm run db:push && npm run db:seed
# If the Prisma client cannot be loaded, ASTRA logs a warning and falls
# back to "memory" rather than failing to boot.
ASTRA_DATA_SOURCE=memory

# ── PostgreSQL ─────────────────────────────────────────────────────
# Only read when ASTRA_DATA_SOURCE=prisma.
# DATABASE_URL="postgresql://astra:astra@localhost:5432/astra?schema=public"
